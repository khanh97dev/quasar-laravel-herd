{
  "name": "quasar-laravel-herd",
  "version": "1.0.0",
  "type": "module",
  "productName": "Quasar Herd",
  "description": "A Laravel Herd-like local PHP development environment for Linux and Windows",
  "author": "ips@ipsupply.com.au",
  "private": true,
  "main": "src-electron/electron-main.js",
  "scripts": {
    "dev": "quasar dev -m electron",
    "build": "quasar build -m electron",
    "build:linux": "quasar build -m electron -T linux",
    "build:win": "quasar build -m electron -T win32",
    "lint": "eslint --ext .js,.vue ./src ./src-electron"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.12",
    "axios": "^1.7.7",
    "node-forge": "^1.3.1",
    "pinia": "^2.2.4",
    "quasar": "^2.17.0",
    "tar": "^7.4.3",
    "unzipper": "^0.12.3",
    "vue": "^3.5.0",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@quasar/app-vite": "^2.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.29.0",
    "postcss": "^8.4.47",
    "vite-plugin-checker": "^0.8.0"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  },
  "homepage": "https://github.com/ipsupply/quasar-laravel-herd",
  "license": "MIT"
}
